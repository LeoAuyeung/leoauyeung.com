---
import Nav from './Nav.astro';
import { site, contacts, isExternal } from '../data/site';
---

<script is:inline>
  // Old single-page links (leoauyeung.com/#experience) now live on /work.
  if (/^#(about|experience|projects)$/.test(location.hash)) location.replace('/work' + location.hash);
</script>

<div class="hero">
  <Nav />
  <main id="main" class="hero__body wrap">
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__line">{site.tagline}</p>
    {site.subline && <p class="hero__sub">{site.subline}</p>}
    <ul class="hero__links label label--lower" aria-label="Contact">
      {contacts.map((c, i) => (
        <li>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <a href={c.href} {...(isExternal(c.href) ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a>
        </li>
      ))}
    </ul>
  </main>
</div>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .hero__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* offset the nav height so the block sits at the true center of the screen */
    padding-bottom: calc(var(--s-5) * 2 + 1.2rem);
  }
  .hero__name,
  .hero__line,
  .hero__sub {
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    font-weight: var(--fw-regular);
    text-wrap: balance;
  }
  .hero__name { color: var(--accent); }
  .hero__line { margin-top: 0; }
  .hero__sub { color: var(--muted); margin-top: var(--s-4); font-size: var(--fs-sub); }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .hero__links a { color: var(--ink); }
  .hero__links a:hover { color: var(--accent); }
</style>
