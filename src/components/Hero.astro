---
import Nav from './Nav.astro';
import { site, contacts, isExternal } from '../data/site';
---

<div class="hero">
  <Nav />
  <div class="hero__body wrap">
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__line">{site.tagline}</p>
    {site.subline && <p class="hero__sub">{site.subline}</p>}
    <ul class="hero__links label label--lower" aria-label="Contact">
      {contacts.map((c, i) => (
        <li>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <a href={c.href} {...(isExternal(c.href) ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a>
        </li>
      ))}
    </ul>
  </div>
  <div class="hero__foot wrap">
    <a class="hero__arrow" href="#about" aria-label="Scroll to about">↓</a>
  </div>
</div>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .hero__body {
    /* sits roughly 40% down the viewport */
    padding-top: calc(40svh - 7.5rem);
    max-width: calc(var(--w-text) + var(--w-label) + var(--s-7) + 2 * var(--gutter));
  }
  .hero__name,
  .hero__line,
  .hero__sub {
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
    font-weight: var(--fw-regular);
    max-width: 28ch;
  }
  .hero__name { color: var(--accent); }
  .hero__sub { color: var(--muted); margin-top: 0; }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    row-gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .hero__links a { color: var(--ink); }
  .hero__links a:hover { color: var(--accent); }
  .hero__foot { padding-block: var(--s-6); }
  .hero__arrow {
    display: inline-block;
    font-family: var(--font-mono);
    color: var(--muted);
    padding: var(--s-2);
    margin-left: calc(-1 * var(--s-2));
  }
  .hero__arrow:hover { color: var(--accent); text-decoration: none; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__arrow { animation: nudge 2.4s var(--ease) 1.5s 2; }
    @keyframes nudge { 50% { transform: translateY(6px); } }
  }
</style>
