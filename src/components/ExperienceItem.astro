---
import type { Job } from '../data/experience';

interface Props {
  job: Job;
}
const { job } = Astro.props;
const [latest, ...earlier] = job.roles;
---

<article class="job">
  <h3 class="job__head">
    {job.url ? <a href={job.url} target="_blank" rel="noopener">{job.company}</a> : job.company}
    <span class="muted"> — {latest.title}</span>
  </h3>
  <p class="label">
    {latest.start} — {latest.end}<span class="sep" aria-hidden="true">·</span>{job.city}
  </p>
  <p class="job__team">{latest.team}</p>
  {earlier.map((r) => (
    <div class="job__role">
      <p class="muted">{r.title}</p>
      <p class="label">{r.start} — {r.end}</p>
      <p class="job__team">{r.team}</p>
    </div>
  ))}
</article>

<style>
  .job + :global(.job) { margin-top: var(--s-6); }
  .job__head { font-weight: var(--fw-medium); }
  .job__head .muted { font-weight: var(--fw-regular); }
  .job p + p { margin-top: 0; }
  .job__role { margin-top: var(--s-3); }
  .job__team { margin-top: var(--s-1); font-size: var(--fs-small); }
</style>
