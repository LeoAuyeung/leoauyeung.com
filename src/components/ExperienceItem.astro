---
import type { Job } from '../data/experience';

interface Props {
  job: Job;
}
const { job } = Astro.props;
---

<article class="job">
  <h3 class="job__head">
    {job.url ? <a href={job.url} target="_blank" rel="noopener">{job.company}</a> : job.company}
    <span class="muted"> — {job.title}</span>
  </h3>
  <p class="label">
    {job.start} — {job.end}<span class="sep" aria-hidden="true">·</span>{job.city}
  </p>
  <p class="job__team">{job.team}</p>
</article>

<style>
  .job + :global(.job) { margin-top: var(--s-6); }
  .job__head { font-weight: var(--fw-medium); }
  .job__head .muted { font-weight: var(--fw-regular); }
  .job p + p { margin-top: var(--s-1); }
  .job__team { font-size: var(--fs-small); }
</style>
