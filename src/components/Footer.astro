---
import { site } from '../data/site';

const { wide = false } = Astro.props as { wide?: boolean };
---

<footer class:list={['footer', 'wrap', 'label', { 'wrap--wide': wide }]}>
  <p>Designed and built by {site.name}, {site.year}</p>
  <p><a href={site.source} target="_blank" rel="noopener">source ↗</a></p>
</footer>

<style>
  .footer {
    text-transform: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-8) var(--s-6);
  }
  .footer p + p { margin-top: 0; }
  .footer a { color: var(--ink); }
  .footer a:hover { color: var(--accent); }
</style>
