---
// Accessible lightbox for [data-lightbox-group] links.
// Uses a modal <dialog>: the page behind becomes inert (focus trap), Esc closes natively.
// Without JS the grid links simply open the full-size image.
---

<dialog class="lb" aria-label="Photo viewer">
  <div class="lb__bar label label--lower">
    <span class="lb__count" aria-live="polite"></span>
    <button type="button" class="lb__close" data-close>close <span aria-hidden="true">✕</span></button>
  </div>
  <figure class="lb__figure">
    <img class="lb__img" alt="" />
    <figcaption class="lb__caption label label--lower"></figcaption>
  </figure>
  <button type="button" class="lb__nav lb__prev label label--lower" data-prev aria-label="Previous photo">←</button>
  <button type="button" class="lb__nav lb__next label label--lower" data-next aria-label="Next photo">→</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lb');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-group] [data-full]'));

  if (dialog && links.length && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('.lb__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lb__caption')!;
    const count = dialog.querySelector<HTMLElement>('.lb__count')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index].dataset;
      img.src = a.full!;
      img.alt = a.alt ?? '';
      img.width = Number(a.w);
      img.height = Number(a.h);
      caption.textContent = a.caption ?? '';
      caption.hidden = !a.caption;
      count.textContent = `${index + 1} / ${links.length}`;
      // warm the neighbours
      [index + 1, index - 1].forEach((n) => {
        const next = links[(n + links.length) % links.length];
        if (next) new Image().src = next.dataset.full!;
      });
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });

    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    });

    // swipe
    let startX = 0;
    let startY = 0;
    let swiped = false;
    dialog.addEventListener('pointerdown', (e) => { startX = e.clientX; startY = e.clientY; swiped = false; });
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        swiped = true;
        show(index + (dx < 0 ? 1 : -1));
      }
    });

    // a plain click on the empty space around the photo closes (but not the end of a swipe)
    dialog.addEventListener('click', (e) => {
      if (swiped) { swiped = false; return; }
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lb__figure')) dialog.close();
    });
  }
</script>

<style>
  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--overlay);
    color: var(--ink);
    touch-action: pan-y;
  }
  .lb::backdrop { background: var(--overlay); }
  .lb[open] { display: grid; grid-template-rows: auto 1fr; }

  .lb__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--s-4) var(--gutter);
  }
  .lb__close { color: var(--ink); padding: var(--s-2); margin-right: calc(-1 * var(--s-2)); }
  .lb__close:hover { color: var(--accent); }

  .lb__figure {
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    padding: 0 var(--gutter) var(--s-6);
  }
  .lb__img {
    max-width: 100%;
    max-height: calc(100svh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    padding: var(--s-5) var(--s-4);
    color: var(--ink);
    font-size: var(--fs-small);
  }
  .lb__nav:hover { color: var(--accent); }
  .lb__prev { left: 0; }
  .lb__next { right: 0; }
  @media (max-width: 767px) {
    .lb__nav { top: auto; bottom: var(--s-2); transform: none; }
  }
</style>
