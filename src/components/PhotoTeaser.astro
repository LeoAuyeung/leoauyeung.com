---
import { Picture } from 'astro:assets';
import Section from './Section.astro';
import { teaserPhotos } from '../data/photos';

const items = teaserPhotos();
---

<Section id="photos" label="Photos">
  <ul class="teaser">
    {items.map((p) => (
      <li>
        <a href="/photos" class="teaser__item" aria-label={`${p.alt} — see all photos`}>
          <Picture
            src={p.src}
            alt={p.alt}
            width={480}
            height={600}
            fit="cover"
            position={p.position ?? 'center'}
            widths={[240, 480]}
            sizes="(min-width: 768px) 220px, 33vw"
            formats={['avif', 'webp']}
            loading="lazy"
            decoding="async"
          />
        </a>
      </li>
    ))}
  </ul>
  <p class="more label label--lower"><a href="/photos">more photos →</a></p>
</Section>

<style>
  .teaser { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); }
  .teaser__item { display: block; aspect-ratio: 4 / 5; background: var(--faint); overflow: hidden; }
  .teaser__item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: opacity 300ms var(--ease); }
  .teaser__item:hover :global(img) { opacity: 0.88; }
  .more { margin-top: var(--s-4); }
  .more a { color: var(--ink); }
  .more a:hover { color: var(--accent); }
</style>
